
NODE_ENV=development

# 辉
# VUE_APP_API_BASE_URL=http://192.168.0.79:8180/qr-hrm
# 胜：开发环境使用相对路径，浏览器请求会经过 Vue dev server 代理，
# 这样通过 Natapp 访问时不会把 192.168.0.13 内网地址暴露给外部浏览器。
VUE_APP_API_BASE_URL=/qr-hrm
# 后端如果和前端在同一台机器，改成 http://127.0.0.1:8180；
# 如果后端在局域网其他机器，填写该机器可达的内网地址。
VUE_APP_PROXY_TARGET=http://192.168.0.13:8180
VUE_APP_API_BASE_URL=http://192.168.0.42:8180/qr-hrm
# VUE_APP_API_BASE_URL=https://prj.gdzt.net.cn:7080/qr-hrm




VUE_APP_CAS_BASE_URL=http://cas.example.org:8443/cas
# VUE_APP_ONLINE_BASE_URL=http://fileview.jeecg.com/onlinePreview
VUE_APP_ONLINE_BASE_URL=https://prj.gdzt.net.cn:5202/preview/

VUE_APP_BLMAP_BASE_URL=http://localhost:9527/index.html?key=

VUE_APP_TITLE=HRM
